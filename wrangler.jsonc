{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puzzle-zone-multiplayer",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "GameRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameRoom"]}],
  "vars": {"ALLOWED_ORIGINS": "https://rahulsharmarahul.github.io,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173"},
  "observability": {"enabled": false}
}
