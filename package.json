{
  "name": "puzzle-zone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "catalogue": "node scripts/catalogue.mjs",
    "test:e2e": "playwright test",
    "multiplayer:dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "multiplayer:login": "wrangler login",
    "multiplayer:deploy": "wrangler deploy",
    "multiplayer:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test:online": "playwright test --config playwright.online.config.js"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^4.4.0",
    "vite": "^6.3.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
